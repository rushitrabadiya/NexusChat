generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique @db.VarChar(6)
  documents    Document[]
  chatSessions ChatSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Document {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filename  String
  fileType  String
  filePath  String?
  url       String?
  error     String?
  status    DocumentStatus   @default(PENDING)
  chunks    DocumentChunk[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model DocumentChunk {
  id         String                 @id @default(uuid())
  documentId String
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId   String                 
  content    String
  embedding  Unsupported("vector(768)")? 
  createdAt  DateTime               @default(now())
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ChatSession {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String?       
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          Role        
  content       String
  modelUsed     String?     
  sources       String[]    @default([])
  createdAt     DateTime    @default(now())
}

enum Role {
  USER
  AI
  SYSTEM
}

model ApiKey {
  id                 String   @id @default(uuid())
  provider           String   // e.g. Gemini, Groq, OpenRouter, Cohere, Jina, HuggingFace
  name               String   // e.g. GEMINI_API_KEY_1
  key                String   @unique // Encrypted string
  isActive           Boolean  @default(true)
  
  // Rate Limits (Nullable, if null = unlimited)
  limitRequestsMin   Int?
  limitRequestsHour  Int?
  limitRequestsDay   Int?
  limitRequestsMonth Int?
  limitTokensMin     Int?
  limitTokensDay     Int?

  // Persistent Metrics
  usageRequests      Int      @default(0)
  usageTokens        Int      @default(0)
  usageCost          Float    @default(0) // If we want to track $ cost in the future

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
